# Required by SEC EDGAR policy. Use a real contact address, e.g. Name email@example.com
SEC_USER_AGENT=Meridian Research contact@example.com

# Optional Groq-compatible chat provider. Without an API key Meridian uses its
# deterministic, evidence-only domain analyzers and does not invent missing facts.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_VISION_ENABLED=false
CLAIM_JUDGE_ENABLED=false

# Poppler must be on PATH or configured by absolute path. This project-local Tesseract
# path is used when the optional OCR runtime has been installed here.
PDFTOPPM_CMD=pdftoppm
TESSERACT_CMD=tools/tesseract/tesseract.exe

# Local semantic embeddings are the default; the pretrained model is downloaded to this cache
# on first use. Use provider=api to replace it with an OpenAI-compatible endpoint, or provider=hash
# for the dependency-free deterministic fallback. Reindex after changing model/provider.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=models/cache
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Optional transcript adapter endpoint. Response contract is documented in README.md.
TRANSCRIPT_BASE_URL=
TRANSCRIPT_API_KEY=
TRANSCRIPT_ENDPOINT=/transcripts

# Optional annual FX CSV: USD per one unit of reporting currency, with source attribution.
FX_RATES_CSV=data/fx_annual_rates.csv

MERIDIAN_DB=data/meridian.sqlite3
MERIDIAN_UNIVERSE=data/fortune500.csv
MERIDIAN_UPLOAD_DIR=uploads
SEC_MIN_REQUEST_INTERVAL=0.12
RETRIEVAL_LIMIT=8
MAX_UPLOAD_MB=40

